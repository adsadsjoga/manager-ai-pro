generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  name                   String?
  avatarUrl              String?
  plan                   String    @default("free")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  planExpiresAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  clients     Client[]
  adAccounts  AdAccount[]
  alerts      AlertRule[]
  reports     Report[]
  leads       Lead[]
  realSales   RealSale[]
  businessProfiles BusinessProfile[]
  shopifyStores ShopifyStore[]
  shopifyProducts ShopifyProduct[]
  shopifyOrders ShopifyOrder[]
}

model Client {
  id        String   @id @default(uuid())
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  logoUrl   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccounts AdAccount[]
  reports    Report[]
  leads      Lead[]
  realSales  RealSale[]
  businessProfiles BusinessProfile[]
}

model AdAccount {
  id               String    @id @default(uuid())
  userId           String
  clientId         String?
  platform         String    @default("facebook")
  accountId        String
  accountName      String?
  currency         String    @default("EUR")
  timezone         String    @default("America/Sao_Paulo")
  windsorConnected Boolean   @default(false)
  lastSyncAt       DateTime?
  syncStatus       String    @default("pending")
  syncError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id])
  dailyMetrics DailyMetric[]
  aiInsights   AiInsight[]
  alerts       Alert[]
  syncLogs     SyncLog[]
  reports      Report[]
  leads        Lead[]
  metaAds      MetaAd[]
  realSales    RealSale[]
  businessProfiles BusinessProfile[]
  shopifyStores ShopifyStore[]
  shopifyProducts ShopifyProduct[]
  shopifyOrders ShopifyOrder[]

  @@unique([userId, platform, accountId])
}

model BusinessProfile {
  id             String   @id @default(uuid())
  userId         String
  clientId       String?
  adAccountId    String?
  businessName   String
  offer          String?
  targetAudience String?
  country        String?
  language       String   @default("pt-BR")
  averageTicket  Float?
  marginPercent  Float?
  monthlyGoal    Float?
  mainObjective  String?
  brandTone      String?
  websiteUrl     String?
  notes          String?
  aiContext      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  adAccount AdAccount? @relation(fields: [adAccountId], references: [id], onDelete: SetNull)

  @@unique([userId, adAccountId])
}

model DailyMetric {
  id           String   @id @default(uuid())
  adAccountId  String
  date         DateTime
  campaignId   String?
  campaignName String?
  adsetId      String?
  adsetName    String?
  adId         String?
  adName       String?
  platform     String?
  placement    String?
  objective    String?
  impressions  Int      @default(0)
  reach        Int      @default(0)
  frequency    Float    @default(0)
  clicks       Int      @default(0)
  linkClicks   Int      @default(0)
  ctr          Float    @default(0)
  cpc          Float    @default(0)
  cpm          Float    @default(0)
  spend        Float    @default(0)
  leads        Int      @default(0)
  purchases    Int      @default(0)
  revenue      Float    @default(0)
  roas         Float    @default(0)
  costPerLead  Float?
  costPerPurchase Float?
  rawData      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}

model AiInsight {
  id              String   @id @default(uuid())
  adAccountId     String
  campaignId      String?
  insightType     String
  severity        String   @default("info")
  healthScore     Int?
  title           String?
  summary         String?
  fullAnalysis    String?
  recommendations Json?
  metricsSnapshot Json?
  isRead          Boolean  @default(false)
  isActedUpon     Boolean  @default(false)
  actionTaken     String?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}

model Alert {
  id           String    @id @default(uuid())
  adAccountId  String
  alertType    String
  severity     String    @default("warning")
  title        String?
  message      String?
  metrics      Json?
  campaignId   String?
  campaignName String?
  isRead       Boolean   @default(false)
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  cooldownUntil DateTime?
  createdAt    DateTime  @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}

model AlertRule {
  id           String   @id @default(uuid())
  userId       String
  adAccountId  String?
  name         String?
  isActive     Boolean  @default(true)
  metric       String?
  operator     String?
  threshold    Float?
  timeWindow   Int      @default(1)
  severity     String   @default("warning")
  notifyEmail  Boolean  @default(true)
  cooldownHours Int     @default(4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id          String    @id @default(uuid())
  userId      String
  clientId    String?
  adAccountId String?
  name        String?
  reportType  String?
  format      String?
  periodStart DateTime?
  periodEnd   DateTime?
  status      String    @default("pending")
  fileUrl     String?
  shareToken  String?   @unique
  shareExpiresAt DateTime?
  generatedAt DateTime?
  errorMessage String?
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id])
  adAccount AdAccount? @relation(fields: [adAccountId], references: [id])
}

model Lead {
  id                  String   @id @default(uuid())
  userId              String
  clientId            String?
  adAccountId         String?
  name                String?
  email               String?
  phone               String?
  company             String?
  sourceCampaignId    String?
  sourceCampaignName  String?
  sourceAdsetName     String?
  sourceAdName        String?
  sourcePlatform      String?
  estimatedValue      Float?
  stage               String   @default("new")
  extraData           Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id])
  adAccount AdAccount? @relation(fields: [adAccountId], references: [id])
}

model MetaAd {
  id             String   @id @default(uuid())
  adAccountId    String
  metaAdId       String
  campaignId     String?
  campaignName   String?
  adsetId        String?
  adsetName      String?
  adName         String?
  status         String?
  effectiveStatus String?
  creativeId     String?
  creativeName   String?
  primaryText    String?
  headline       String?
  description    String?
  callToAction   String?
  imageUrl       String?
  videoId        String?
  permalinkUrl   String?
  thumbnailUrl   String?
  videoMetrics   Json?
  rawData        Json?
  lastFetchedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@unique([adAccountId, metaAdId])
}

model RealSale {
  id              String   @id @default(uuid())
  userId          String
  adAccountId     String?
  clientId        String?
  provider        String   @default("manual")
  externalId      String?
  status          String   @default("paid")
  amount          Float    @default(0)
  currency        String   @default("EUR")
  customerEmail   String?
  customerName    String?
  productName     String?
  campaignName    String?
  source          String?
  paidAt          DateTime
  rawData         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccount AdAccount? @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
}

model ShopifyStore {
  id             String   @id @default(uuid())
  userId         String
  adAccountId    String?
  shopDomain     String
  storeName      String?
  currency       String   @default("EUR")
  accessTokenEnc String?
  syncStatus     String   @default("not_connected")
  syncError      String?
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccount AdAccount? @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  products  ShopifyProduct[]
  orders    ShopifyOrder[]

  @@unique([userId, shopDomain])
}

model ShopifyProduct {
  id              String   @id @default(uuid())
  userId          String
  adAccountId     String?
  shopifyStoreId  String
  shopifyProductId String
  title           String
  handle          String?
  status          String?
  productType     String?
  vendor          String?
  imageUrl        String?
  price           Float?
  currency        String   @default("EUR")
  inventoryQty    Int?
  rawData         Json?
  lastFetchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccount    AdAccount?   @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  shopifyStore ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)

  @@unique([shopifyStoreId, shopifyProductId])
}

model ShopifyOrder {
  id              String   @id @default(uuid())
  userId          String
  adAccountId     String?
  shopifyStoreId  String
  shopifyOrderId  String
  orderName       String?
  financialStatus String?
  fulfillmentStatus String?
  totalPrice      Float    @default(0)
  subtotalPrice   Float    @default(0)
  totalTax        Float    @default(0)
  currency        String   @default("EUR")
  customerEmail   String?
  customerName    String?
  productSummary  String?
  sourceName      String?
  landingSite     String?
  referringSite   String?
  processedAt     DateTime
  rawData         Json?
  lastFetchedAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccount    AdAccount?   @relation(fields: [adAccountId], references: [id], onDelete: SetNull)
  shopifyStore ShopifyStore @relation(fields: [shopifyStoreId], references: [id], onDelete: Cascade)

  @@unique([shopifyStoreId, shopifyOrderId])
}

model SyncLog {
  id             String    @id @default(uuid())
  adAccountId    String
  syncType       String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String?
  rowsFetched    Int       @default(0)
  rowsUpserted   Int       @default(0)
  dateFrom       DateTime?
  dateTo         DateTime?
  errorMessage   String?

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}
