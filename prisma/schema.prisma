generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  email                  String    @unique
  name                   String?
  avatarUrl              String?
  plan                   String    @default("free")
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  planExpiresAt          DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  clients     Client[]
  adAccounts  AdAccount[]
  alerts      AlertRule[]
  reports     Report[]
  leads       Lead[]
}

model Client {
  id        String   @id @default(uuid())
  userId    String
  name      String
  email     String?
  phone     String?
  company   String?
  logoUrl   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  adAccounts AdAccount[]
  reports    Report[]
  leads      Lead[]
}

model AdAccount {
  id               String    @id @default(uuid())
  userId           String
  clientId         String?
  platform         String    @default("facebook")
  accountId        String
  accountName      String?
  currency         String    @default("BRL")
  timezone         String    @default("America/Sao_Paulo")
  windsorConnected Boolean   @default(false)
  lastSyncAt       DateTime?
  syncStatus       String    @default("pending")
  syncError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client       Client?       @relation(fields: [clientId], references: [id])
  dailyMetrics DailyMetric[]
  aiInsights   AiInsight[]
  alerts       Alert[]
  syncLogs     SyncLog[]
  reports      Report[]
  leads        Lead[]

  @@unique([userId, platform, accountId])
}

model DailyMetric {
  id           String   @id @default(uuid())
  adAccountId  String
  date         DateTime
  campaignId   String?
  campaignName String?
  adsetId      String?
  adsetName    String?
  adId         String?
  adName       String?
  platform     String?
  placement    String?
  objective    String?
  impressions  Int      @default(0)
  reach        Int      @default(0)
  frequency    Float    @default(0)
  clicks       Int      @default(0)
  linkClicks   Int      @default(0)
  ctr          Float    @default(0)
  cpc          Float    @default(0)
  cpm          Float    @default(0)
  spend        Float    @default(0)
  leads        Int      @default(0)
  purchases    Int      @default(0)
  revenue      Float    @default(0)
  roas         Float    @default(0)
  costPerLead  Float?
  costPerPurchase Float?
  rawData      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}

model AiInsight {
  id              String   @id @default(uuid())
  adAccountId     String
  campaignId      String?
  insightType     String
  severity        String   @default("info")
  healthScore     Int?
  title           String?
  summary         String?
  fullAnalysis    String?
  recommendations Json?
  metricsSnapshot Json?
  isRead          Boolean  @default(false)
  isActedUpon     Boolean  @default(false)
  actionTaken     String?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}

model Alert {
  id           String    @id @default(uuid())
  adAccountId  String
  alertType    String
  severity     String    @default("warning")
  title        String?
  message      String?
  metrics      Json?
  campaignId   String?
  campaignName String?
  isRead       Boolean   @default(false)
  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  cooldownUntil DateTime?
  createdAt    DateTime  @default(now())

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}

model AlertRule {
  id           String   @id @default(uuid())
  userId       String
  adAccountId  String?
  name         String?
  isActive     Boolean  @default(true)
  metric       String?
  operator     String?
  threshold    Float?
  timeWindow   Int      @default(1)
  severity     String   @default("warning")
  notifyEmail  Boolean  @default(true)
  cooldownHours Int     @default(4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id          String    @id @default(uuid())
  userId      String
  clientId    String?
  adAccountId String?
  name        String?
  reportType  String?
  format      String?
  periodStart DateTime?
  periodEnd   DateTime?
  status      String    @default("pending")
  fileUrl     String?
  shareToken  String?   @unique
  shareExpiresAt DateTime?
  generatedAt DateTime?
  errorMessage String?
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id])
  adAccount AdAccount? @relation(fields: [adAccountId], references: [id])
}

model Lead {
  id                  String   @id @default(uuid())
  userId              String
  clientId            String?
  adAccountId         String?
  name                String?
  email               String?
  phone               String?
  company             String?
  sourceCampaignId    String?
  sourceCampaignName  String?
  sourceAdsetName     String?
  sourceAdName        String?
  sourcePlatform      String?
  estimatedValue      Float?
  stage               String   @default("new")
  extraData           Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?    @relation(fields: [clientId], references: [id])
  adAccount AdAccount? @relation(fields: [adAccountId], references: [id])
}

model SyncLog {
  id             String    @id @default(uuid())
  adAccountId    String
  syncType       String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String?
  rowsFetched    Int       @default(0)
  rowsUpserted   Int       @default(0)
  dateFrom       DateTime?
  dateTo         DateTime?
  errorMessage   String?

  adAccount AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
}